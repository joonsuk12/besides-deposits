# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.
# 1단계에서는 비워 둬도 기본값으로 동작한다.

# DATABASE_URL=sqlite:///C:/경로/stroll.db

# 2단계: 네이버 검색 API (https://developers.naver.com)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 공시: OpenDART 인증키 (https://opendart.fss.or.kr → 인증키 신청, 무료)
# DART_API_KEY=

# ETF 구성종목 비중: KRX 정보데이터시스템 (https://data.krx.co.kr, 무료 회원가입)
# 네이버·카카오 간편가입이 아니라 "아이디/비밀번호로 회원가입"한 계정이어야 pykrx가 로그인한다.
# KRX_ID=
# KRX_PW=
